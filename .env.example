# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://auroraelitesuits.com

# Aurora assistant (Groq). Without a key the assistant still answers from the site's FAQ index.
GROQ_API_KEY=
# Optional: override the model (default llama-3.3-70b-versatile)
GROQ_MODEL=

# Optional: email delivery for the enquiry form via Resend. Without it, guests are handed to WhatsApp with a pre-filled message.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=bookings@auroraelitesuits.com
ENQUIRY_FROM_EMAIL=Aurora Elite Suites <onboarding@resend.dev>
